def is_valid(reg):
"""Valid form: 2 letters, 2 digits, 1 or 2 letters, 4 digits (e.g. TN09AB1234)."""
# TODO 2: Check the length is 9 or 10, then check each part using slicing with
# isalpha() and isdigit()
length = len(reg)
if length not in [9, 10]:
return False
# Part 1: First 2 must be letters (State)
if not reg[0:2].isalpha():
return False
# Part 2: Next 2 must be digits (District)
if not reg[2:4].isdigit(): return False
# Part 3 & 4: Depends on length (Series and Pin)
if length == 9:
# Format: LL DD L DDDD
series = reg[4:5]
pin = reg[5:]
else:
# Format: LL DD LL DDDD
series = reg[4:6]
pin = reg[6:]
return series.isalpha() and pin.isdigit()
