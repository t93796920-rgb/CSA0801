import re
def normalize_phone(phone_str):
# Removes all non-digit characters
return re.sub(r'\D', '', str(phone_str))
def merge_contacts(contacts_list):
# Key: Normalized Phone Number
# Value: Dictionary with sets for names, numbers, and emails
merged = {}
for contact in contacts_list:
name = contact.get('name') numbers = contact.get('numbers', [])
emails = contact.get('emails', [])
# Normalize all numbers for this contact
norm_nums = [normalize_phone(n) for n in numbers if normalize_phone(n)]
for n in norm_nums:
if n not in merged:
merged[n] = {
'names': {name} if name else set(),
'numbers': {n},
'emails': set(emails)
}
else:
# If number exists, merge the new info into the existing set
if name:
merged[n]['names'].add(name)
merged[n]['emails'].update(emails)
merged[n]['numbers'].add(n)
return merged
