print("Blank entry ignored.")
continue # Does not count as an attempt
if entry == "1234": # Let's assume '1234' is the correct OTP
print("Access Granted!")
return True
else:
attempts += 1
print(f"Wrong OTP. Attempts remaining: {attempts_allowed - attempts}")
else:
# This executes only if the while loop completes without a 'break'
print("ACCOUNT LOCKED for 30 minutes.")
return False
def otp_verification_for(attempts_allowed):
print(f"\n--- Starting For Loop Verification ({attempts_allowed} attempts) ---")
for i in range(attempts_allowed):
entry = input("Enter OTP (or leave blank to skip): ").strip()
if entry == "":
print("Blank entry ignored.")
continue
if entry == "1234": print("Access Granted!")
break
else:
print(f"Wrong OTP. Attempt {i+1} failed.")
else:
print("ACCOUNT LOCKED for 30 minutes.")
return False
